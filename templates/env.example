# OpenCode Forge — copy to .env (never commit a real .env).
# Only used for optional integrations. Empty by default.

# Home Assistant long-lived token (only if you enable the HA MCP).
# Get it from HA profile -> Long-lived access tokens, then:
#   [System.Environment]::SetEnvironmentVariable("HOMEASSISTANT_TOKEN","<paste>","User")
HOMEASSISTANT_TOKEN=

# Home Assistant base URL (default local, change only for your network).
HOMEASSISTANT_URL=http://127.0.0.1:8123/api/mcp
