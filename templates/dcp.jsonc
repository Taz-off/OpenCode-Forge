// OpenCode Forge — DCP defaults (quality first, prune duplicates + old errors only).
{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "autoUpdate": true,
  "pruneNotification": "detailed",
  "pruneNotificationType": "chat",
  "turnProtection": { "enabled": true, "turns": 8 },
  "experimental": { "allowSubAgents": true },
  "compress": {
    "mode": "range",
    "permission": "allow",
    "showCompression": true,
    "summaryBuffer": true,
    "minContextLimit": 120000,
    "maxContextLimit": 200000,
    "nudgeFrequency": 8,
    "iterationNudgeThreshold": 25,
    "nudgeForce": "soft",
    "protectTags": true,
    "protectUserMessages": true
  },
  "strategies": {
    "deduplication": { "enabled": true },
    "purgeErrors": { "enabled": true, "turns": 8 }
  }
}
